# .env.example
# ------------
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the real `.env` file to version control.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your tokens


# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------

# Your Telegram Bot token from @BotFather.
BOT_TOKEN=your-telegram-bot-token-here


# ---------------------------------------------------------------------------
# AI Provider
# ---------------------------------------------------------------------------

# Which AI backend to use.
# Options: "openai" | "groq" | "gemini"
AI_PROVIDER=

# Your API key. For OpenAI: starts with "sk-...".
OPENAI_API_KEY=your-api-key-here

# For Groq: get one free at https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# Google Gemini (free tier — 1 500 req/day, no credit card required)
# Get your key at: https://aistudio.google.com/ → Get API key → Create API key
GEMINI_API_KEY=your-gemini-api-key

# ---------------------------------------------------------------------------
# Persistence (optional)
# ---------------------------------------------------------------------------
# Controls whether user preferences (e.g. last chosen AI provider) survive
# a bot restart. "none" = in-memory only (default). "sqlite" = SQLite file.
#
# PERSISTENCE_BACKEND=none
# SQLITE_DB_PATH=data/bot.db     # only used when PERSISTENCE_BACKEND=sqlite

# (Optional) Override the model. Leave blank to use the provider default.
# OpenAI default : gpt-4o-mini
# Groq default   : llama3-70b-8192
# Gemini default : gemini-2.0-flash
AI_MODEL=

# (Optional) Custom base URL for OpenAI-compatible providers.
# Leave blank for standard OpenAI usage.
# For Groq:     https://api.groq.com/openai/v1
# For Gemini:   https://generativelanguage.googleapis.com/v1beta/openai/
AI_BASE_URL=


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Python logging level. Options: DEBUG | INFO | WARNING | ERROR
# Default: INFO
LOG_LEVEL=INFO
